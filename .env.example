# Copy to .env and edit. `make run` reads .env; the server itself reads only its environment.
# One NAME=value per line, no quotes, no spaces around =. Unset lines use the default.

# Port on 127.0.0.1.
PORT=8767
# State of the current pass. It holds the answer keys: the directory is 0700, the file 0600.
DATA_DIR=./data
# Top-level decks graded by meaning, comma-separated. All other decks are graded as language cards.
KNOWLEDGE_DECKS=Tech,Career
# AnkiConnect endpoint.
ANKI_CONNECT_URL=http://127.0.0.1:8765
# Sync with AnkiWeb before a pass and after writing grades.
ANKI_SYNC=true
# Claude Code binary.
CLAUDE_BIN=claude
# Model for grading, for example sonnet. Default: the CLI's default.
# CLAUDE_MODEL=
# Longest time one grading call may take.
GRADE_TIMEOUT=5m
# debug, info, warn or error.
LOG_LEVEL=info

# ---------------------------------------------------------------------------------------------
# Deployment (setup skill / deploy kit only). The server ignores these; see deploy/README.md.
# ---------------------------------------------------------------------------------------------
# SSH login of the deploy user on the server (in the docker group, with sudo).
# DEPLOY_SSH=user@server.example.com
# SSH port of the server.
# DEPLOY_SSH_PORT=22
# Deploy dir on the server. Default: the deploy user's $HOME/anki-review-deploy.
# DEPLOY_DIR=/home/user/anki-review-deploy
# Port of the service on the server (its PORT). Default: 8767.
# DEPLOY_PORT=8767
# Public URL behind your reverse proxy: the setup page and the final check. Optional.
# DEPLOY_URL=https://review.example.com
