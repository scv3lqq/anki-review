# build output
/bin/

# state of the current pass: holds answer keys
/data/

# test and coverage output
*.test
*.out

# Server recovery keys must remain outside the repository. Guard accidental copies too.
**/session.key
**/.session-key.*

# local environment
.env
.env.*
!.env.example

# deploy kit state, if up.sh or an upload ever runs inside the checkout
/deploy/anki/secrets/
/deploy/bin/
/deploy/claude-token
# Dedicated OAuth staging must never be committed.
**/auth.json
**/.codex/
**/anki-review-login.*/
**/anki-review-import.*/
/deploy/install-state
/deploy/.install-state.*

# editors and OS
.idea/
.vscode/
.DS_Store
